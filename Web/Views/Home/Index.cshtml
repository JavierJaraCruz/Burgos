@model Web.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Panel de Control";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Panel de Control</h1>
</div>

<div class="dashboard-grid">

    <div class="stat-card">
        <div class="stat-icon icon-blue">📦</div>
        <div class="stat-info">
            <h3>@Model.CantidadProductos</h3>
            <p>Productos</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-green">🛒</div>
        <div class="stat-info">
            <h3>@Model.CantidadVentas</h3>
            <p>Ventas</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-orange">⚠️</div>
        <div class="stat-info">
            <h3>@Model.StockBajo</h3>
            <p>Stock Bajo</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-purple">💵</div>
        <div class="stat-info">
            <h3>@Model.TotalVentasMonto.ToString("C2", new System.Globalization.CultureInfo("es-PE"))</h3>
            <p>Total Ventas</p>
        </div>
    </div>

</div>

<div class="status-main-card">
    <div class="status-content">
        @if (Model.StockBajo == 0)
        {
            <div class="status-circle-success">
                <span class="checkmark">✓</span>
            </div>
        }
        else
        {
            <div class="status-circle-warning" style="background-color: #fef3c7; color: #d97706; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 20px;">
                <span>!</span>
            </div>
        }
        <p class="status-text">@Model.MensajeEstado</p>
    </div>
</div>