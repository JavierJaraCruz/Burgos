@model IEnumerable<Web.ViewModels.KardexViewModel>

@{
    ViewBag.Title = "Kardex";
}

<h2>Kardex del Producto</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Fecha</th>
            <th>Tipo Movimiento</th>
            <th>Cantidad</th>
            <th>Referencia</th>
            <th>Saldo</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@item.TipoMovimiento</td>
                <td>@item.Cantidad</td>
                <td>@item.Referencia</td>
                <td>@item.Saldo</td>
            </tr>
        }

    </tbody>
    

</table>

<p>
    @Html.ActionLink(
        "Volver a Productos",
        "Index",
        "Producto",
        null,
        new { @class = "btn btn-secondary" })
</p>
