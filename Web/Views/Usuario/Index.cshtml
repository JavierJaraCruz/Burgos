@model IEnumerable<Entities.Usuario>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Usuarios</h1>
    <a href="@Url.Action("Crear")" class="btn-primary" style="text-decoration: none;">＋ Crear Nuevo</a>
</div>

<div class="table-container">
    <table id="usuariosTable" class="custom-table">
        <thead>
            <tr>
                <th>Nombre Usuario</th>
                <th>Email</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.NombreUsuario</td>
                    <td>@u.Email</td>
                    <td>@(u.Estado ? "Activo" : "Inactivo")</td>
                    <td>
                        <div class="table-actions">
                            <a href="@Url.Action("Detalle", new { id = u.UsuarioId })" class="btn-table-edit" style="text-decoration: none;">🔍 Detalle</a>
                            <a href="@Url.Action("Editar", new { id = u.UsuarioId })" class="btn-table-edit" style="text-decoration: none;">✏️ Editar</a>
                            <a href="@Url.Action("Delete", new { id = u.UsuarioId })" class="btn-table-delete" style="text-decoration: none;">🗑️ Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button id="clearSearch" class="btn-primary" style="background-color: #64748b; margin-top: 20px;">🧹 Borrar búsqueda</button>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#usuariosTable').DataTable({
                paging: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                searching: true,
                language: {
                    search: "🔎 Buscar:",
                    lengthMenu: "Mostrar _MENU_ filas",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                }
            });

            $('#clearSearch').on('click', function () {
                table.search('').draw();
            });
        });
    </script>
}