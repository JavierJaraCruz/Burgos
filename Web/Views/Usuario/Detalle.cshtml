@model Entities.Usuario
@{
    ViewBag.Title = "Detalle Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h2>Detalle Usuario</h2>
</div>

<div class="details-card">
    <div class="detail-row">
        <span class="detail-label">ID:</span>
        <span class="detail-value">@Model.UsuarioId</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Nombre Usuario:</span>
        <span class="detail-value">@Model.NombreUsuario</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Email:</span>
        <span class="detail-value">@Model.Email</span>
    </div>

    @* NUEVO: Fila para mostrar el Rol *@
    <div class="detail-row">
        <span class="detail-label">Rol Asignado:</span>
        <span class="detail-value">@(ViewBag.RolNombre ?? "Sin Rol Asignado")</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Fecha Registro:</span>
        <span class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Estado:</span>
        <span class="detail-value">@(Model.Estado ? "Activo" : "Inactivo")</span>
    </div>
</div>

<div class="actions-bar" style="margin-top: 20px;">
    @Html.ActionLink("✏️ Editar", "Editar", new { id = Model.UsuarioId }, new { @class = "btn btn-primary", @style = "text-decoration: none; margin-right: 10px;" })
    @Html.ActionLink("⬅️ Volver", "Index", null, new { @class = "btn btn-secondary", @style = "text-decoration: none;" })
</div>