@model Web.ViewModels.CategoriaViewModel

@{
    ViewBag.Title = "Detalle de Categoría";
}

<h2>Detalle de Categoría</h2>

<hr />

<dl class="dl-horizontal">

    
    <dt>ID</dt>
    <dd>@Model.CategoriaId</dd>

    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>

    <dt>Descripción</dt>
    <dd>@Model.Descripcion</dd>
    

</dl>

<p>
    @Html.ActionLink(
        "Editar",
        "Editar",
        new { id = Model.CategoriaId },
        new { @class = "btn btn-primary" })

    
    @Html.ActionLink(
        "Volver",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
    

</p>
