@{
    Layout = null;
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Burgos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/sidebar.css" rel="stylesheet" />
    <link href="~/Content/index.css" rel="stylesheet" />
    <link href="~/Content/create.css" rel="stylesheet" />
    <link href="~/Content/detalle.css" rel="stylesheet" />

</head>
<body>

    <aside id="sidebar" class="sidebar">
        <div class="sidebar-brand">
            <h2>Sistema Inventario</h2>
            <span>ecommerce Burgos</span>
        </div>

        <ul class="sidebar-menu">
            <li class="@(controllerActual == "Orden" ? "active" : "")">
                <a href="@Url.Action("Index","Orden")">
                    🛒 <span>Ventas</span>
                </a>
            </li>
            
            </li>
            <li class="@(controllerActual == "Producto" ? "active" : "")">
                <a href="@Url.Action("Index","Producto")">📦 <span>Productos</span></a>
            </li>
            <li class="@(controllerActual == "Categoria" ? "active" : "")">
                <a href="@Url.Action("Index","Categoria")">🏷 <span>Categorías</span></a>
            </li>
            <li class="@(controllerActual == "Proveedor" ? "active" : "")">
                <a href="@Url.Action("Index","Proveedor")">🚚 <span>Proveedores</span></a>
            </li>
            <li class="@(controllerActual == "Usuario" ? "active" : "")">
                <a href="@Url.Action("Index","Usuario")">👥 <span>Usuarios</span></a>
            </li>
        </ul>

        <div class="sidebar-profile">
            <div class="profile-icon">👤</div>
            <div class="profile-info">
                <span class="profile-name">Admin</span>
                <span class="profile-role">Administrador</span>
            </div>
        </div>
    </aside>

    <main class="content">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>