@model IEnumerable<Web.ViewModels.ProveedorViewModel>

@{
    ViewBag.Title = "Proveedores";
}

<div class="page-header">
    <h1>Proveedores</h1>
    <a href="@Url.Action("Crear")" class="btn-primary">＋ Nuevo Proveedor</a>
</div>

<div class="table-container">
    <table class="custom-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProveedorId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Email</td>
                    <td>@item.Telefono</td>
                    <td>@item.Direccion</td>
                    <td>
                        <div class="table-actions">
                            <a href="@Url.Action("Detalle", new { id = item.ProveedorId })" class="btn-table-edit" style="text-decoration: none;">🔍 Detalle</a>
                            <a href="@Url.Action("Editar", new { id = item.ProveedorId })" class="btn-table-edit" style="text-decoration: none;">✏️ Editar</a>
                            <a href="@Url.Action("Eliminar", new { id = item.ProveedorId })" class="btn-table-delete" style="text-decoration: none;">🗑️ Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>