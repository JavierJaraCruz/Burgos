@model IEnumerable<Entities.Rol>
@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>Roles</h1>
    <a href="@Url.Action("Crear")" class="btn-primary">＋ Crear Nuevo</a>
</div>

<div class="table-container">
    <table id="rolesTable" class="custom-table">
        <thead>
            <tr>
                <th>Nombre Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.NombreRol</td>
                    <td>
                        <div class="table-actions">
                            <a href="@Url.Action("Detalle", new { id = r.RolId })" class="btn-table-edit" style="text-decoration: none;">🔍 Detalle</a>
                            <a href="@Url.Action("Editar", new { id = r.RolId })" class="btn-table-edit" style="text-decoration: none;">✏️ Editar</a>
                            <a href="@Url.Action("Eliminar", new { id = r.RolId })" class="btn-table-delete" style="text-decoration: none;">🗑️ Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button id="clearSearchRoles" class="btn-primary" style="background-color: #64748b; margin-top: 20px;">🧹 Borrar búsqueda</button>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#rolesTable').DataTable({
                paging: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                searching: true,
                language: { search: "🔎 Buscar:" }
            });
            $('#clearSearchRoles').on('click', function () { table.search('').draw(); });
        });
    </script>
}