@model Web.ViewModels.OrdenViewModel

@{
    ViewBag.Title = "Detalle de Orden";
}

<h2>Detalle de Orden</h2>

<div class="card">
    <div class="card-body">

        <p>
            <strong>ID:</strong>
            @Model.OrdenId
        </p>

        <p>
            <strong>Usuario:</strong>
            @Model.UsuarioId
        </p>

        <p>
            <strong>Fecha:</strong>
            @Model.FechaOrden.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Total:</strong>
            S/ @Model.Total
        </p>

        <p>
            <strong>Estado:</strong>
            @Model.Estado
        </p>

    </div>
</div>

<br />

<p>
    @Html.ActionLink(
        "Volver",
        "Index",
        null,
        new { @class = "btn btn-secondary" })
</p>