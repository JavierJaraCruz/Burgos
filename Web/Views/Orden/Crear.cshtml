@model Web.ViewModels.OrdenViewModel

<h2>Nueva Orden</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Usuario ID</label>
        @Html.DropDownListFor(
     m => m.UsuarioId,
     Model.Usuarios,
     "-- Seleccione un usuario --",
     new { @class = "form-control" }
 )
    </div>

    <hr />

    <h4>Detalle</h4>

    <div class="form-group">
        <label>Producto ID</label>
        @Html.DropDownList(
    "Detalles[0].ProductoId",
    Model.Productos,
    "-- Seleccione un producto --",
    new { @class = "form-control" }
)
    </div>

    <div class="form-group">
        <label>Cantidad</label>
        <input type="number"
               name="Detalles[0].Cantidad"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Precio Unitario</label>
        <input type="number"
               step="0.01"
               name="Detalles[0].PrecioUnitario"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Subtotal</label>
        <input type="number"
               step="0.01"
               name="Detalles[0].Subtotal"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Guardar Orden
    </button>
}